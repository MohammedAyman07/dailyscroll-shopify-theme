<script>
  function openLightbox(src) {
    document.getElementById('lightboxImg').src = src;
    document.getElementById('imgLightbox').classList.add('open');
    document.body.style.overflow = 'hidden';
  }
  function closeLightbox() {
    document.getElementById('imgLightbox').classList.remove('open');
    document.body.style.overflow = '';
  }
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeLightbox();
  });

  function changeMainImage(imgUrl, thumbElement) {
    document.getElementById('mainProductImage').src = imgUrl;
    var thumbs = document.querySelectorAll('.amz-thumb');
    thumbs.forEach(function(el) { el.classList.remove('active'); });
    thumbElement.classList.add('active');
  }

  // ===== BUNDLE & SAVE JS =====
  var bundleBasePrice = {{ product.price }};  // price in cents
  var bundleDiscounts = { 1: 1.0, 2: 0.85, 3: 0.75 };
  var currentBundleTier = 1;

  function formatMoney(cents) {
    return '$' + (cents / 100).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
  }

  function selectBundleTier(tier) {
    currentBundleTier = tier;

    // Update radio buttons
    [1,2,3].forEach(function(t) {
      var radio = document.getElementById('radio' + t);
      if (radio) {
        if (t === tier) radio.classList.add('selected');
        else radio.classList.remove('selected');
      }
    });

    // Update quantity hidden field
    var qtySelect = document.getElementById('quantity');
    if (qtySelect) qtySelect.value = tier;

    // Update buy box price display
    var discount = bundleDiscounts[tier];
    var bundleTotal = Math.round(bundleBasePrice * tier * discount);
    var buyPrice = document.querySelector('.amz-buy-price');
    if (buyPrice) buyPrice.textContent = formatMoney(bundleTotal);

    // Add discount code note to cart
    var note = tier === 1 ? '' : ('BUNDLE' + tier + ' auto-applied');
    var noteEl = document.getElementById('bundleDiscountNote');
    if (noteEl) noteEl.style.display = tier > 1 ? 'block' : 'none';
  }

  // Init bundle on page load
  document.addEventListener('DOMContentLoaded', function() {
    selectBundleTier(1);
  });

  var productVariants = {{ product.variants | json }};


  function selectVariantOption(element, optionName) {
    // 1. Get the value safely from the DOM to avoid quote escaping issues
    var value = element.innerText.trim();

    // 2. Update UI
    var parent = element.parentElement;
    var pills = parent.querySelectorAll('.amz-variant-pill');
    pills.forEach(function(pill) { pill.classList.remove('selected'); });
    element.classList.add('selected');
    document.getElementById('selected-' + optionName).innerText = value;
    
    // 3. Gather all currently selected options in order (Option1, Option2, Option3)
    var selectedPills = document.querySelectorAll('.amz-variant-pill.selected');
    var currentOptions = Array.from(selectedPills).map(function(p) {
      return p.innerText.trim();
    });
    
    // 4. Find matching variant from Shopify JSON
    var matchedVariant = productVariants.find(function(v) {
       var match = true;
       if (currentOptions[0] && v.option1 !== currentOptions[0]) match = false;
       if (currentOptions[1] && v.option2 !== currentOptions[1]) match = false;
       if (currentOptions[2] && v.option3 !== currentOptions[2]) match = false;
       return match;
    });
    
    // 5. Update the hidden select so Add To Cart works correctly
    if (matchedVariant) {
      document.getElementById('productSelect').value = matchedVariant.id;
    }
  }

  function buyNow() {
    var form = document.getElementById('addToCartForm');
    var input = document.createElement('input');
    input.type = 'hidden';
    input.name = 'return_to';
    input.value = '/checkout';
    form.appendChild(input);
    form.submit();
  }

  function scrollRelated(trackId, dir) {
    var track = document.getElementById(trackId);
    track.scrollBy({ left: dir * 620, behavior: 'smooth' });
  }

  // ---- WISHLIST: sync heart state on load ----
  document.addEventListener('DOMContentLoaded', function(){
    var list = getWishlist();
    var btn = document.getElementById('productWishlistBtn');
    if (btn) {
      var pid = btn.getAttribute('data-product-id');
      if (list.some(function(p){ return p.id === pid; })) {
        btn.classList.add('wishlisted');
      }
    }

    // ---- RECENTLY VIEWED: track & render ----
    addRecentlyViewed({
      id: '{{ product.id }}',
      title: '{{ product.title | escape }}',
      url: '{{ product.url }}',
      img: '{{ product.featured_image | img_url: "400x" }}',
      price: '{{ product.price | money }}'
    });
    renderRecentlyViewed('rvTrack', '{{ product.id }}');
    // ---- URGENCY LOGIC ----
    var viewerCountEl = document.getElementById('viewerCount');
    if (viewerCountEl) {
      setInterval(function() {
        var current = parseInt(viewerCountEl.innerText);
        var change = Math.floor(Math.random() * 5) - 2; // -2 to +2
        var newVal = current + change;
        if (newVal < 15) newVal = 15;
        if (newVal > 89) newVal = 89;
        viewerCountEl.innerText = newVal;
      }, 4000);
    }
    
    var countdownEl = document.getElementById('countdownTimer');
    if (countdownEl) {
      // Create a unique time for this product based on its ID so it's not the same everywhere
      // E.g., anywhere between 1 hour (3600s) and 6 hours (21600s)
      var maxTime = 21600; 
      var minTime = 3600;
      var uniqueIdTime = {{ product.id | modulo: 18000 | plus: 3600 }};
      var timeLeft = uniqueIdTime;
      
      setInterval(function() {
        if (timeLeft <= 0) timeLeft = uniqueIdTime;
        timeLeft--;
        var h = Math.floor(timeLeft / 3600);
        var m = Math.floor((timeLeft % 3600) / 60);
        var s = timeLeft % 60;
        countdownEl.innerText = (h<10?'0':'')+h+':'+(m<10?'0':'')+m+':'+(s<10?'0':'')+s;
      }, 1000);
    }
  });
</script>
