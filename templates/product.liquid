<style>
  /* ---- FULL WIDTH BANNER ---- */
  .amz-banner-section {
    background: #000;
    padding: 60px 5% 40px;
    border-top: 1px solid rgba(255,255,255,0.07);
  }
  .amz-banner-label {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: #e5ff00;
    padding: 0 0 24px;
    text-transform: uppercase;
  }
  .amz-banner-images { 
    display: flex; 
    flex-direction: column; 
    gap: 30px; /* Gap between images */
  }
  .amz-banner-slide {
    width: 100%;
    position: relative;
    overflow: hidden;
    cursor: zoom-in;
    border-radius: 12px; /* Rounded corners */
  }
  .amz-banner-slide img {
    width: 100%;
    height: auto;
    object-fit: contain;
    display: block;
    transition: transform 0.5s ease;
  }
  .amz-banner-slide:hover img { transform: scale(1.02); }
  .amz-banner-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0);
    display: flex;
    align-items: flex-end;
    padding: 20px;
    transition: background 0.3s;
  }
  .amz-banner-overlay span {
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    opacity: 0;
    transition: opacity 0.3s;
  }
  .amz-banner-slide:hover .amz-banner-overlay { background: rgba(0,0,0,0.3); }
  .amz-banner-slide:hover .amz-banner-overlay span { opacity: 1; }

  /* ---- LIGHTBOX ---- */
  .amz-fullview-hint {
    position: absolute;
    bottom: 16px;
    left: 50%;
    transform: translateX(-50%) translateY(4px);
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(229,255,0,0.25);
    border-radius: 40px;
    padding: 6px 18px;
    font-size: 0.7rem;
    color: rgba(255,255,255,0.7);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    pointer-events: none;
    white-space: nowrap;
    font-weight: 700;
    opacity: 0;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
  .amz-main-image:hover .amz-fullview-hint {
    opacity: 1;
    color: #e5ff00;
    border-color: rgba(229,255,0,0.6);
    transform: translateX(-50%) translateY(0);
  }
  .amz-main-image { cursor: zoom-in; position: relative; }

  .amz-lightbox {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(0,0,0,0.96);
    justify-content: center;
    align-items: center;
    flex-direction: column;
    padding: 20px;
  }
  .amz-lightbox.open { display: flex; }
  .amz-lightbox img {
    max-width: 90vw;
    max-height: 90vh;
    object-fit: contain;
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 6px;
  }
  .amz-lightbox-close {
    position: absolute;
    top: 20px;
    right: 30px;
    background: none;
    border: 1px solid rgba(255,255,255,0.3);
    color: #fff;
    font-size: 1.4rem;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    cursor: pointer;
    line-height: 1;
    transition: all 0.2s;
  }
  .amz-lightbox-close:hover { border-color: #e5ff00; color: #e5ff00; }

  /* ---- RELATED SECTIONS ---- */
  .amz-related-section {
    background: #080808;
    border-top: 1px solid rgba(255,255,255,0.07);
    padding: 60px 5%;
  }
  .amz-related-section--dark { background: #050505; }
  .amz-related-inner { max-width: 1600px; margin: 0 auto; }
  .amz-related-header { margin-bottom: 30px; }
  .amz-related-title {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: clamp(1.2rem, 2.5vw, 2rem);
    font-weight: 900;
    letter-spacing: 0.08em;
    color: #fff;
    text-transform: uppercase;
  }
  .amz-related-scroll-wrap {
    position: relative;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .amz-related-track {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
    flex: 1;
    padding: 4px 0 10px;
  }
  .amz-related-track::-webkit-scrollbar { display: none; }
  .amz-scroll-btn {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.15);
    color: #fff;
    font-size: 1.8rem;
    width: 42px;
    height: 80px;
    border-radius: 4px;
    cursor: pointer;
    flex-shrink: 0;
    transition: all 0.2s;
    line-height: 1;
  }
  .amz-scroll-btn:hover { border-color: #e5ff00; color: #e5ff00; background: rgba(229,255,0,0.06); }

  .amz-rp-card {
    flex-shrink: 0;
    width: 190px;
    background: #0f0f0f;
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 6px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    transition: border-color 0.25s, transform 0.25s;
  }
  .amz-rp-card:hover { border-color: rgba(229,255,0,0.4); transform: translateY(-4px); }
  .amz-rp-img-wrap {
    width: 100%;
    aspect-ratio: 1;
