<!-- PRODUCT DETAILS SECTION -->
<style>
  .amz-product-wrapper {
    padding: 120px 5% 100px;
    max-width: 1600px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 35% 40% 20%;
    justify-content: space-between;
    gap: 2rem;
    color: var(--text-primary, #fff);
    font-family: 'Barlow', sans-serif;
  }
  
  /* --- LEFT COLUMN: MEDIA --- */
  .amz-media-col {
    display: flex;
    gap: 1rem;
    position: sticky;
    top: 100px;
    height: fit-content;
  }
  .amz-thumbnails {
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 60px;
    flex-shrink: 0;
  }
  .amz-thumb {
    width: 60px;
    height: 60px;
    border: 1px solid rgba(255,255,255,0.2);
    border-radius: 4px;
    cursor: pointer;
    background: #111;
    overflow: hidden;
    transition: border-color 0.2s;
  }
  .amz-thumb:hover, .amz-thumb.active {
    border-color: #e5ff00;
  }
  .amz-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .amz-main-image {
    flex-grow: 1;
    background: #0d0d0d;
    border: 1px solid rgba(255,255,255,0.05);
    border-radius: 8px;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 1rem;
  }
  .amz-main-image img {
    max-width: 100%;
    height: auto;
    filter: drop-shadow(0 10px 20px rgba(0,0,0,0.5));
  }

  /* --- MIDDLE COLUMN: INFO --- */
  .amz-info-col {
    display: flex;
    flex-direction: column;
  }
  .amz-vendor {
    color: #e5ff00;
    font-weight: 700;
    letter-spacing: 0.1em;
    font-size: 0.85rem;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
  }
  .amz-title {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: clamp(2rem, 3vw, 3rem);
    line-height: 1.1;
    margin-bottom: 0.5rem;
    text-transform: uppercase;
  }
  .amz-rating {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 1rem;
    font-size: 0.85rem;
    color: #e5ff00;
  }
  .amz-rating span {
    color: #aaa;
  }
  .amz-price-block {
    border-top: 1px solid rgba(255,255,255,0.1);
    padding-top: 1rem;
    margin-bottom: 1.5rem;
  }
  .amz-price-row {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .amz-sale-price {
    font-size: 2.2rem;
    font-weight: 700;
    color: #fff;
  }
  .amz-compare-price {
    text-decoration: line-through;
    color: #666;
    font-size: 1.2rem;
  }
  .amz-taxes {
    font-size: 0.8rem;
    color: #aaa;
    margin-top: 5px;
  }
  
  .amz-variants-wrapper {
    margin-bottom: 2rem;
  }
  .amz-option-name {
    font-weight: 700;
    margin-bottom: 0.5rem;
    font-size: 0.9rem;
    text-transform: uppercase;
    color: #ccc;
  }
  .amz-option-values {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 1rem;
  }
  .amz-variant-pill {
    padding: 8px 16px;
    border: 1px solid rgba(255,255,255,0.2);
    border-radius: 4px;
    cursor: pointer;
    font-size: 0.85rem;
    background: #111;
    color: #fff;
    transition: all 0.2s;
  }
  .amz-variant-pill:hover {
    background: #222;
  }
  .amz-variant-pill.selected {
    border-color: #e5ff00;
    background: rgba(229,255,0,0.1);
    color: #e5ff00;
  }

  .amz-about-item {
    border-top: 1px solid rgba(255,255,255,0.1);
    padding-top: 1rem;
  }
  .amz-about-title {
    font-weight: 700;
    margin-bottom: 1rem;
    font-size: 1rem;
    text-transform: uppercase;
  }
  .amz-about-content {
    font-size: 0.95rem;
    line-height: 1.6;
    color: #ccc;
  }
  .amz-about-content ul {
    padding-left: 20px;
  }
  .amz-about-content li {
    margin-bottom: 8px;
  }
  .amz-about-content img,
  .amz-about-content video,
  .amz-about-content iframe {
    max-width: 100% !important;
    height: auto !important;
    border-radius: 8px;
    margin: 40px 0 !important; /* Increased gap between images */
    display: block;
  }

  /* --- RIGHT COLUMN: BUY BOX --- */
  .amz-buy-box {
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: 8px;
    padding: 1.5rem;
    background: #0d0d0d;
    height: fit-content;
    position: sticky;
    top: 100px;
    min-width: 250px;
  }
  .amz-buy-price {
    font-size: 1.8rem;
    font-weight: 700;
    margin-bottom: 1rem;
  }
  .amz-delivery {
    font-size: 0.85rem;
    color: #aaa;
    margin-bottom: 1rem;
  }
  .amz-delivery strong {
    color: #fff;
  }
  .amz-stock {
    color: #e5ff00;
    font-weight: 700;
    font-size: 1.1rem;
    margin-bottom: 1rem;
    text-transform: uppercase;
  }
  
  .amz-qty-row {
    margin-bottom: 1.5rem;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .amz-qty-select {
    background: #1a1a1a;
    border: 1px solid #333;
    color: #fff;
    padding: 8px 12px;
    border-radius: 4px;
    font-family: inherit;
    cursor: pointer;
    flex-grow: 1;
  }
  
  .amz-btn {
    width: 100%;
    padding: 14px;
    border-radius: 40px;
    font-family: 'Barlow', sans-serif;
    font-weight: 800;
    font-size: 0.9rem;
    cursor: pointer;
    text-align: center;
    text-transform: uppercase;
    transition: all 0.2s;
    margin-bottom: 10px;
    border: none;
  }
  .amz-btn-add {
    background: #e5ff00;
    color: #000;
  }
  .amz-btn-add:hover {
    background: #c8e600;
  }
  .amz-btn-buy {
    background: #fff;
    color: #000;
  }
  .amz-btn-buy:hover {
    background: #e6e6e6;
  }
  
  .amz-seller-info {
    margin-top: 1rem;
    font-size: 0.75rem;
    color: #888;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 8px 15px;
  }
  .amz-seller-info span.value {
    color: #ddd;
  }
  
  /* --- TRUST & SCARCITY --- */
  .amz-scarcity {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8rem;
    color: #ccc;
    margin-bottom: 1rem;
    padding: 8px 12px;
    background: rgba(229,255,0,0.05);
    border: 1px solid rgba(229,255,0,0.2);
    border-radius: 4px;
  }
  .pulse-dot {
    width: 8px;
    height: 8px;
    background-color: #ff3333;
    border-radius: 50%;
    box-shadow: 0 0 0 0 rgba(255, 51, 51, 1);
    animation: pulse-red 2s infinite;
  }
  @keyframes pulse-red {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(255, 51, 51, 0.7); }
    70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(255, 51, 51, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(255, 51, 51, 0); }
  }
  .amz-scarcity strong { color: #fff; }

  .amz-trust-section {
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255,255,255,0.1);
  }
  .amz-trust-title {
    font-size: 0.7rem;
    font-weight: 700;
    text-align: center;
    letter-spacing: 0.15em;
    color: #aaa;
    margin-bottom: 12px;
  }
  .amz-trust-pills {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
    margin-bottom: 15px;
  }
  .amz-trust-pills span {
    font-size: 0.65rem;
    font-weight: 800;
    padding: 4px 8px;
    border: 1px solid rgba(255,255,255,0.2);
    border-radius: 4px;
    color: #fff;
    background: #1a1a1a;
  }
  .amz-trust-guarantee {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 0.8rem;
    font-weight: 700;
    color: #e5ff00;
  }

  @media (max-width: 1024px) {
    .amz-product-wrapper {
      grid-template-columns: 1fr;
      gap: 3rem;
      padding-top: 100px;
    }
    .amz-media-col, .amz-buy-box {
      position: static;
    }
    .amz-media-col {
      flex-direction: column-reverse;
    }
    .amz-thumbnails {
      flex-direction: row;
      width: 100%;
      overflow-x: auto;
    }
  }

  /* ===== BUNDLE & SAVE ===== */
  .bundle-wrap {
    background: #111;
    border: 1px solid rgba(229,255,0,0.2);
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 18px;
  }
  .bundle-header {
    display: flex;
    align-items: center;
    gap: 8px;
    background: rgba(229,255,0,0.08);
    padding: 10px 16px;
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    border-bottom: 1px solid rgba(229,255,0,0.15);
  }
  .bundle-tiers {
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .bundle-tier {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    cursor: pointer;
    border-bottom: 1px solid rgba(255,255,255,0.06);
    transition: background 0.2s;
    min-height: 60px;
  }
  .bundle-tier:last-child { border-bottom: none; }
  .bundle-tier:hover { background: rgba(255,255,255,0.03); }
  .bundle-tier--highlight {
    background: rgba(229,255,0,0.05);
    border-left: 3px solid var(--accent);
  }
  .bundle-tier--highlight.active,
  .bundle-tier--highlight {
    background: rgba(229,255,0,0.07);
  }
  .bundle-radio {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 2px solid rgba(255,255,255,0.3);
    flex-shrink: 0;
    position: relative;
    transition: border-color 0.2s;
  }
  .bundle-radio.selected {
    border-color: var(--accent);
  }
  .bundle-radio.selected::after {
    content: '';
    position: absolute;
    top: 3px; left: 3px;
    width: 8px; height: 8px;
    border-radius: 50%;
    background: var(--accent);
  }
  .bundle-tier-info {
    flex: 1;
  }
  .bundle-tier-label {
    font-size: 0.95rem;
    font-weight: 600;
    color: #fff;
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 3px;
    flex-wrap: nowrap;
    white-space: nowrap;
  }
  .bundle-popular-tag {
    background: var(--accent);
    color: #000;
    font-size: 0.6rem;
    font-weight: 900;
    padding: 2px 8px;
    border-radius: 20px;
    letter-spacing: 0.08em;
    font-family: 'Barlow Condensed', sans-serif;
    text-transform: uppercase;
  }
  .bundle-tier-price-row {
    display: flex;
    align-items: baseline;
    gap: 5px;
    flex-wrap: nowrap;
  }
  .bundle-tier-price {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--accent);
  }
  .bundle-tier-each {
    font-size: 0.72rem;
    color: rgba(255,255,255,0.45);
    white-space: nowrap;
  }
  .bundle-tier-saving {
    font-size: 0.75rem;
    color: #4caf50;
    font-weight: 600;
    margin-top: 2px;
  }
  .bundle-tier-badge {
    background: rgba(229,255,0,0.12);
    color: var(--accent);
    font-size: 0.65rem;
    font-weight: 900;
    padding: 4px 10px;
    border-radius: 20px;
    letter-spacing: 0.08em;
    font-family: 'Barlow Condensed', sans-serif;
    text-transform: uppercase;
    white-space: nowrap;
    border: 1px solid rgba(229,255,0,0.25);
  }
  .bundle-tier-badge--gold {
    background: rgba(255,200,0,0.1);
    color: #ffc800;
    border-color: rgba(255,200,0,0.3);
  }
  .bundle-total-display {
    background: rgba(229,255,0,0.06);
    border: 1px solid rgba(229,255,0,0.15);
    border-radius: 8px;
    padding: 10px 14px;
    margin-bottom: 14px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: 'Barlow Condensed', sans-serif;
  }
  .bundle-total-label {
    font-size: 0.85rem;
    color: rgba(255,255,255,0.5);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .bundle-total-price {
    font-size: 1.5rem;
    font-weight: 800;
    color: #fff;
  }
  .bundle-total-original {
    text-decoration: line-through;
    color: rgba(255,255,255,0.3);
    font-size: 0.9rem;
    margin-left: 8px;
  }
  .bundle-discount-code-note {
    font-size: 0.78rem;
    color: #4caf50;
    text-align: center;
    padding: 6px 0 10px;
    font-weight: 600;
  }
</style>

<form method="post" action="/cart/add" id="addToCartForm" class="amz-product-wrapper">
  
  <!-- LEFT: MEDIA -->
  <div class="amz-media-col">
    <div class="amz-thumbnails">
      {% if product.images.size > 0 %}
        {% for image in product.images limit: 6 %}
          <div class="amz-thumb {% if forloop.first %}active{% endif %}" onclick="changeMainImage('{{ image | img_url: '1000x' }}', this)">
            <img src="{{ image | img_url: '100x' }}" alt="{{ product.title | escape }} thumbnail">
          </div>
        {% endfor %}
      {% else %}
        <div class="amz-thumb active">
          <img src="{{ product.featured_image | img_url: '100x' }}" alt="{{ product.title | escape }} thumbnail">
        </div>
      {% endif %}
    </div>
    <div class="amz-main-image" onclick="openLightbox(this.querySelector('img').src)" title="Click to see full view">
      <img id="mainProductImage" src="{{ product.featured_image | img_url: '1000x' }}" alt="{{ product.title | escape }}">
      <div class="amz-fullview-hint">🔍 Click to see full view</div>
    </div>
  </div>

  <!-- MIDDLE: INFO -->
  <div class="amz-info-col">
    <div class="amz-vendor">DailyScroll</div>
    <h1 class="amz-title">{{ product.title }}</h1>
    
    <div class="amz-rating">
      <!-- Judge.me Star Rating Badge -->
      <a class="jdgm-summary-stars-rating jdgm-widget" href="#judgeme_product_reviews"
         data-id="{{ product.id }}"
         data-product-title="{{ product.title | escape }}">
        {{ product.metafields.judgeme.badge }}
      </a>
    </div>

    <div class="amz-price-block">
      <div class="amz-price-row">
        <span class="amz-sale-price">{{ product.price | money }}</span>
        {% if product.compare_at_price > product.price %}
          <span class="amz-compare-price">M.R.P: {{ product.compare_at_price | money }}</span>
        {% endif %}
      </div>
      <div class="amz-taxes">Inclusive of all taxes</div>
      
      {% if product.compare_at_price > product.price %}
        {% assign save_money = product.compare_at_price | minus: product.price %}
        {% assign save_percent = save_money | times: 100.0 | divided_by: product.compare_at_price | round %}
        <div class="prd-offer-box">
          <div class="prd-offer-header">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
            LIMITED TIME OFFER
          </div>
          <div class="prd-offer-text">
            You save <span class="prd-offer-highlight">{{ save_money | money }} ({{ save_percent }}%)</span> if you order today.
          </div>
        </div>
      {% endif %}

    </div>

    <!-- HIDDEN SELECT FOR SHOPIFY -->
    <select name="id" id="productSelect" style="display:none;">
      {% for variant in product.variants %}
        <option value="{{ variant.id }}" data-price="{{ variant.price }}" {% if variant == product.selected_or_first_available_variant %}selected="selected"{% endif %}>
          {{ variant.title }}
        </option>
      {% endfor %}
    </select>

    {% if product.options.size > 0 and product.variants[0].title != 'Default Title' %}
      <div class="amz-variants-wrapper">
        {% for option in product.options_with_values %}
          <div class="amz-option-group">
            <div class="amz-option-name">{{ option.name }}: <span id="selected-{{ option.name | handleize }}" style="color:#fff;">{{ option.selected_value }}</span></div>
            <div class="amz-option-values">
              {% for value in option.values %}
                <div class="amz-variant-pill {% if option.selected_value == value %}selected{% endif %}" 
                     onclick="selectVariantOption(this, '{{ option.name | handleize }}')">
                  {{ value }}
                </div>
              {% endfor %}
            </div>
          </div>
        {% endfor %}
      </div>
    {% endif %}

    <div class="amz-about-item">
      <div class="amz-about-title">About this item</div>
      <div class="amz-about-content">
        {{ product.description }}
      </div>
    </div>
  </div>

  <!-- RIGHT: BUY BOX -->
  <div class="amz-buy-box">
    <div class="amz-buy-price">{{ product.price | money }}</div>
    
    <!-- HIGH URGENCY ELEMENTS -->
    <div class="urgency-wrapper">
      
      <div class="urgency-row">
        <div class="pulse-ring"><div class="pulse-dot"></div></div>
        <div class="urgency-text"><strong id="viewerCount">{{ product.id | modulo: 38 | plus: 24 }}</strong> people viewing this right now</div>
      </div>
      
      {% if product.available %}
        <div class="urgency-row" style="margin-top: 14px;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#ff3333" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0; margin-top:2px;"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
          <div class="urgency-text">
            {% assign rand_stock = product.id | modulo: 11 | plus: 4 %}
            <span style="color:#ff3333; font-weight:800; text-transform:uppercase;">High Demand</span> &mdash; Only <strong id="stockCount" style="color:#fff;">{{ rand_stock }}</strong> left in stock
          </div>
        </div>
        <div class="urgency-progress">
          <div class="urgency-progress-bar" style="width: {{ product.id | modulo: 40 | plus: 15 }}%;"></div>
        </div>
      {% else %}
        <div class="amz-stock" style="margin-top: 14px;"><span style="color:#ff3333; font-weight:800;">SOLD OUT</span></div>
      {% endif %}

      <div class="urgency-timer-box">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        <div class="urgency-timer-text">
          SALE ENDS IN <strong id="countdownTimer" style="color:var(--accent); font-size:1.1em; letter-spacing:0.05em; margin-left:6px;">04:29:59</strong>
        </div>
      </div>

    </div>

    <!-- BUNDLE & SAVE SECTION -->
    <div class="bundle-wrap" id="bundleWrap">
      <div class="bundle-header">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 01-2.83 0L2 12V2h10l8.59 8.59a2 2 0 010 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
        BUNDLE &amp; SAVE — BEST VALUE
      </div>
      <div class="bundle-tiers">

        <!-- TIER 1: Buy 1 -->
        <div class="bundle-tier" id="tier1" onclick="selectBundleTier(1)">
          <div class="bundle-radio" id="radio1"></div>
          <div class="bundle-tier-info">
            <div class="bundle-tier-label">Buy <strong>1</strong></div>
            <div class="bundle-tier-price-row">
              <span class="bundle-tier-price" id="price1">{{ product.price | money }}</span>
              <span class="bundle-tier-each">/ each</span>
            </div>
          </div>
          <div class="bundle-tier-badge" style="opacity:0;">—</div>
        </div>

        <!-- TIER 2: Buy 2 -->
        <div class="bundle-tier bundle-tier--highlight" id="tier2" onclick="selectBundleTier(2)">
          <div class="bundle-radio selected" id="radio2"></div>
          <div class="bundle-tier-info">
            <div class="bundle-tier-label">Buy <strong>2</strong> <span class="bundle-popular-tag">MOST POPULAR</span></div>
            <div class="bundle-tier-price-row">
              <span class="bundle-tier-price" id="price2">{{ product.price | times: 2 | times: 0.85 | money }}</span>
              <span class="bundle-tier-each">/ for both</span>
            </div>
            <div class="bundle-tier-saving" id="saving2"></div>
          </div>
          <div class="bundle-tier-badge">SAVE 15%</div>
        </div>

        <!-- TIER 3: Buy 3 -->
        <div class="bundle-tier" id="tier3" onclick="selectBundleTier(3)">
          <div class="bundle-radio" id="radio3"></div>
          <div class="bundle-tier-info">
            <div class="bundle-tier-label">Buy <strong>3</strong></div>
            <div class="bundle-tier-price-row">
              <span class="bundle-tier-price" id="price3">{{ product.price | times: 3 | times: 0.75 | money }}</span>
              <span class="bundle-tier-each">/ for all 3</span>
            </div>
            <div class="bundle-tier-saving" id="saving3"></div>
          </div>
          <div class="bundle-tier-badge bundle-tier-badge--gold">SAVE 25%</div>
        </div>

      </div>
    </div>

    <div class="amz-qty-row" style="display:none;">
      <label for="quantity" style="font-size:0.9rem; font-weight:700;">Quantity: </label>
      <select name="quantity" id="quantity" class="amz-qty-select">
        <option value="1">1</option>
        <option value="2">2</option>
        <option value="3">3</option>
        <option value="4">4</option>
        <option value="5">5</option>
      </select>
    </div>



    <button type="submit" class="amz-btn amz-btn-add" {% unless product.available %}disabled{% endunless %}>
      Add to Cart
    </button>
    
    <button type="button" class="amz-btn amz-btn-buy" onclick="buyNow()" {% unless product.available %}disabled{% endunless %}>
      Buy Now
    </button>

    <button type="button"
      class="amz-btn amz-btn-wishlist wishlist-heart-btn"
      id="productWishlistBtn"
      data-product-id="{{ product.id }}"
      data-product-title="{{ product.title | escape }}"
      data-product-url="{{ product.url }}"
      data-product-img="{{ product.featured_image | img_url: '400x' }}"
      onclick="toggleWishlist('{{ product.id }}', '{{ product.title | escape }}', '{{ product.url }}', '{{ product.featured_image | img_url: '400x' }}', this)">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
      <span class="wishlist-btn-text">Add to Wishlist</span>
    </button>

    <div class="amz-seller-info">
      <span>Payment</span> <span class="value" style="color:#e5ff00;">Secure transaction</span>
      <span>Ships from</span> <span class="value">DailyScroll</span>
      <span>Sold by</span> <span class="value">DailyScroll</span>
    </div>

    <div class="amz-trust-section">
      <div class="amz-trust-title">SECURE & ENCRYPTED CHECKOUT</div>
      <div class="amz-trust-pills">
        <span>VISA</span>
        <span>MASTERCARD</span>
        <span>AMEX</span>
        <span>PAYPAL</span>
        <span>APPLE PAY</span>
      </div>
      <div class="amz-trust-guarantee">
        <span style="font-size: 1.1rem;">🛡️</span> Premium Quality Assured
      </div>
    </div>
  </div>
  
</form>

