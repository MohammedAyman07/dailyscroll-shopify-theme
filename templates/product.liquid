  /* =============================================
     JUDGE.ME REVIEWS SECTION
  ============================================= */
  .amz-reviews-section {
    background: #0a0a0a;
    border-top: 1px solid rgba(255,255,255,0.07);
    padding: 80px 5%;
  }
  .amz-reviews-inner {
    max-width: 1400px;
    margin: 0 auto;
  }
  .amz-reviews-header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 40px;
  }
  .amz-reviews-title {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: clamp(1.4rem, 2.5vw, 2.2rem);
    font-weight: 900;
    text-transform: uppercase;
    margin: 0;
    letter-spacing: 0.05em;
    color: #fff;
  }

  /* =============================================
     JUDGE.ME DARK THEME — COLOR ONLY OVERRIDES
     Never touch display/layout/padding of jdgm
     elements to avoid breaking their internal grid
  ============================================= */

  /* Global text color — DO NOT override font-family here,
     it would break Judge.me's icon font (stars become boxes) */
  #judgeme_product_reviews,
  #judgeme_product_reviews p,
  #judgeme_product_reviews span:not(.jdgm-star),
  #judgeme_product_reviews div,
  #judgeme_product_reviews a {
    color: #ccc;
  }

  /* Restore Barlow font on text elements only */
  #judgeme_product_reviews p,
  #judgeme_product_reviews div,
  #judgeme_product_reviews a,
  #judgeme_product_reviews button {
    font-family: 'Barlow', sans-serif;
  }

  /* Stars */
  .jdgm-star {
    color: #e5ff00 !important;
  }
  .jdgm-star.jdgm--off {
    color: #444 !important;
  }
  .jdgm-star:hover {
    color: #e5ff00 !important;
  }

  /* Modal Form Dark Theme */
  .jdgm-form-wrapper,
  .jdgm-modal {
    background: #111 !important;
    color: #ccc !important;
  }
  .jdgm-form {
    background: #0f0f0f !important;
    border-radius: 8px;
    padding: 24px;
    border: 1px solid rgba(255,255,255,0.1);
  }
  .jdgm-form__title,
  .jdgm-modal__title {
    color: #fff !important;
    font-family: 'Barlow Condensed', sans-serif !important;
  }
  .jdgm-form input,
  .jdgm-form textarea {
    background: #000 !important;
    border: 1px solid rgba(255,255,255,0.15) !important;
    color: #fff !important;
    font-family: 'Barlow', sans-serif !important;
  }
  .jdgm-form input:focus,
  .jdgm-form textarea:focus {
    border-color: #e5ff00 !important;
  }

  /* Summary score & count text */
  .jdgm-summary__score { color: #fff !important; }
  .jdgm-summary__ratings-count,
  .jdgm-summary__ratings-count a { color: #aaa !important; }

  /* Histogram bars */
  .jdgm-histogram__bar-content { background: #e5ff00 !important; }
  .jdgm-histogram__bar-background { background: rgba(255,255,255,0.08) !important; }
  .jdgm-histogram__item,
  .jdgm-histogram__item-label { color: #aaa !important; }
  .jdgm-histogram__item-count { color: #888 !important; }



  /* Review cards */
  .jdgm-rev {
    border-color: rgba(255,255,255,0.08) !important;
    background: #0f0f0f !important;
    transition: border-color 0.25s;
  }
  .jdgm-rev:hover { border-color: rgba(229,255,0,0.3) !important; }
