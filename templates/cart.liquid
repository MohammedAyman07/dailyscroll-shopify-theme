<!-- CART PAGE SECTION -->
<style>
  .cart-page-wrapper {
    padding: 150px 5% 100px;
    max-width: 1000px;
    margin: 0 auto;
    font-family: 'Barlow', sans-serif;
    min-height: 80vh;
  }
  .cart-page-title {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 3rem;
    text-transform: uppercase;
    margin-bottom: 3rem;
    text-align: center;
  }
  .cart-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 2rem;
  }
  .cart-table th {
    text-align: left;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border);
    color: var(--text-muted);
    font-weight: 700;
    letter-spacing: 0.1em;
    font-size: 0.8rem;
    text-transform: uppercase;
  }
  .cart-table td {
    padding: 2.5rem 0;
    border-bottom: 1px solid rgba(255,255,255,0.05);
    vertical-align: middle;
  }
  .cart-item-row:hover {
    background: rgba(255,255,255,0.01);
  }
  .cart-item-info {
    display: flex;
    align-items: center;
    gap: 2rem;
    padding-left: 1rem;
  }
  .cart-item-img {
    width: 120px;
    height: 120px;
    background: #0a0a0a;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border);
    transition: transform 0.3s ease, border-color 0.3s ease;
  }
  .cart-item-row:hover .cart-item-img {
    transform: scale(1.05);
    border-color: rgba(200,255,0,0.3);
  }
  .cart-item-img img {
    max-width: 85%;
    max-height: 85%;
    filter: drop-shadow(0 10px 20px rgba(0,0,0,0.5));
  }
  .cart-item-title {
    font-size: 1.3rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    letter-spacing: 0.02em;
  }
  .cart-item-remove {
    color: #ff3333;
    font-size: 0.8rem;
    text-decoration: none;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: color 0.2s;
  }
  .cart-item-remove:hover {
    color: #ff6666;
  }
  .cart-qty-wrapper {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--border);
    background: #111;
  }
  .cart-qty-btn {
    background: transparent;
    color: #fff;
    border: none;
    padding: 0.5rem 1rem;
    cursor: pointer;
    font-size: 1.2rem;
    transition: color 0.2s;
  }
  .cart-qty-btn:hover {
    color: var(--accent);
  }
  .cart-qty-input {
    background: transparent;
    border: none;
    color: #fff;
    width: 40px;
    text-align: center;
    font-family: var(--font);
    font-weight: 700;
    font-size: 1rem;
    -moz-appearance: textfield;
  }
  .cart-qty-input::-webkit-outer-spin-button,
  .cart-qty-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
  .cart-footer {
    display: flex;
    justify-content: flex-end;
    flex-direction: column;
    align-items: flex-end;
    margin-top: 2rem;
  }
  .cart-subtotal {
    font-size: 1.8rem;
    font-weight: 900;
    margin-bottom: 1rem;
    font-family: 'Barlow Condensed', sans-serif;
    letter-spacing: 0.05em;
  }
  .cart-checkout-btn {
    background: var(--accent);
    color: var(--black);
    border: none;
    padding: 1.2rem 3rem;
    font-family: 'Barlow', sans-serif;
    font-weight: 900;
    font-size: 1rem;
    letter-spacing: 0.15em;
    cursor: pointer;
    text-transform: uppercase;
    transition: background 0.3s, transform 0.2s;
  }
  .cart-checkout-btn:hover {
    background: #fff;
    transform: translateY(-2px);
  }
  .cart-discount-wrapper {
    margin-bottom: 2rem;
    display: flex;
    justify-content: flex-end;
  }
  .discount-input {
    background: #111;
    border: 1px solid var(--border);
    color: #fff;
    padding: 12px 16px;
    font-family: var(--font);
    font-size: 0.9rem;
    width: 250px;
    outline: none;
    transition: border-color 0.3s;
    text-transform: uppercase;
  }
  .discount-input:focus {
    border-color: var(--accent);
  }
  .empty-cart-msg {
    text-align: center;
    color: #888;
    font-size: 1.2rem;
  }
</style>

<div class="cart-page-wrapper">
  <h1 class="cart-page-title">YOUR BAG</h1>

  {% if cart.item_count > 0 %}
    <form action="/cart" method="post" novalidate class="cart-form">
      <div class="cart-table-wrapper" style="overflow-x: auto;">
        <table class="cart-table" style="min-width: 700px;">
        <thead>
          <tr>
            <th style="width: 50%;">OBJECT</th>
            <th style="width: 15%;">PRICE</th>
            <th style="width: 20%;">QTY</th>
            <th style="width: 15%; text-align: right;">TOTAL</th>
          </tr>
        </thead>
        <tbody>
          {% for item in cart.items %}
            <tr class="cart-item-row">
              <td>
                <div class="cart-item-info">
                  <a href="{{ item.url }}" class="cart-item-img">
                    <img src="{{ item | img_url: 'medium' }}" alt="{{ item.title | escape }}">
                  </a>
                  <div>
                    <div class="cart-item-title"><a href="{{ item.url }}" style="color:inherit;text-decoration:none; transition: color 0.2s;" onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color='inherit'">{{ item.product.title }}</a></div>
                    {% unless item.product.has_only_default_variant %}
                      <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 0.5rem;">{{ item.variant.title }}</p>
                    {% endunless %}
                    <a href="/cart/change?line={{ forloop.index }}&amp;quantity=0" class="cart-item-remove">REMOVE</a>
                  </div>
                </div>
              </td>
              <td style="font-size: 1.1rem;">{{ item.price | money }}</td>
              <td>
                <div class="cart-qty-wrapper">
                  <button type="button" class="cart-qty-btn" onclick="this.nextElementSibling.stepDown(); this.closest('form').submit();">−</button>
                  <input type="number" name="updates[]" id="updates_{{ item.key }}" value="{{ item.quantity }}" min="0" class="cart-qty-input" onchange="this.closest('form').submit();">
                  <button type="button" class="cart-qty-btn" onclick="this.previousElementSibling.stepUp(); this.closest('form').submit();">+</button>
                </div>
              </td>
              <td style="text-align: right; font-weight: 700; font-size: 1.2rem; color: var(--accent);">{{ item.line_price | money }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
      </div>

      <div class="cart-footer">

        <div class="cart-subtotal">SUBTOTAL: <span style="color: #fff;">{{ cart.total_price | money }}</span></div>
        <p style="color: var(--text-muted); margin-bottom: 2rem; font-size: 0.9rem; letter-spacing: 0.05em;">Shipping & taxes calculated at checkout</p>
        <div>
          <button type="submit" name="update" style="display: none;">UPDATE</button>
          <button type="submit" name="checkout" class="cart-checkout-btn">CHECKOUT →</button>
        </div>
      </div>
    </form>
    
    <script>
      document.querySelector('.cart-form').addEventListener('submit', function(e) {
        if (e.submitter && e.submitter.name === 'checkout') {
          window.location.href = '/checkout';
        }
      });
    </script>
  {% else %}
    <div class="empty-cart-msg">
      <p style="margin-bottom: 2rem;">YOUR BAG IS EMPTY.</p>
      <a href="{{ routes.all_products_collection_url }}" class="cart-checkout-btn" style="text-decoration: none; display: inline-block;">CONTINUE SHOPPING</a>
    </div>
  {% endif %}
</div>
