<!-- NEW DROP SECTION -->
<section class="new-drop-section" id="newdrop">
  <div class="section-label">— /// NEW DROP / NO.001</div>
  <h2 class="section-big-title">OBJECTS</h2>
  

  <div class="products-grid" id="shop">
    {% assign featured_collection = collections['frontpage'] %}
    {% if featured_collection.products.size == 0 %}
      {% assign featured_collection = collections['all'] %}
    {% endif %}
    
    {% if featured_collection.products.size > 0 %}
      {% for product in featured_collection.products limit:6 %}
        <div class="product-card {% if forloop.last %}featured-card{% endif %}" data-id="{{ product.id }}">
          <a href="{{ product.url | within: collection }}" class="stretched-link" aria-label="{{ product.title | escape }}"></a>
          <div class="product-img-wrap {% if forloop.last %}featured-img-wrap{% endif %}">
            <a href="{{ product.url | within: collection }}">
              <img src="{{ product.featured_image | img_url: '600x' }}" alt="{{ product.title | escape }}" class="product-img" />
            </a>
            <div class="product-overlay">
              <a href="{{ product.url | within: collection }}"><span>VIEW OBJECT</span></a>
            </div>
            {% if forloop.last %}<div class="featured-badge">FEATURED</div>{% endif %}
          </div>
          <div class="product-info">
            <div class="product-meta">
              <div>
                <a href="{{ product.url | within: collection }}" style="text-decoration:none; color:inherit;">
                  <div class="product-name">{{ product.title }}</div>
                </a>
              </div>
              <div class="product-price">{{ product.price | money }}</div>
            </div>
            <div class="product-actions">
              <form method="post" action="/cart/add">
                <input type="hidden" name="id" value="{{ product.variants.first.id }}" />
                <button type="submit" class="add-to-bag">ADD TO BAG</button>
              </form>
            </div>
          </div>
        </div>
      {% endfor %}
    {% else %}
      <p style="color: #666; font-family: 'Barlow', sans-serif;">No products found in the "frontpage" collection. Please add some products to see them here.</p>
    {% endif %}
  </div>

  <div style="text-align: center; margin-top: 60px;">
    <a href="{{ routes.all_products_collection_url }}" class="cta-btn">VIEW ALL OBJECTS →</a>
  </div>
</section>



