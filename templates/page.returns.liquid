<!-- RETURNS PAGE -->
<style>
  .custom-page-wrapper {
    padding: 150px 5% 100px;
    max-width: 800px;
    margin: 0 auto;
    font-family: 'Barlow', sans-serif;
    min-height: 80vh;
  }
  .custom-page-title {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: clamp(40px, 8vw, 100px);
    text-transform: uppercase;
    margin-bottom: 2rem;
    color: #888;
    line-height: 1;
    line-height: 1;
  }
  .custom-page-content {
    line-height: 1.8;
    color: var(--text-muted);
    font-size: 1.1rem;
    border-top: 1px solid var(--border);
    padding-top: 2rem;
    margin-top: 2rem;
  }
  .custom-page-content p {
    margin-bottom: 1.5rem;
  }
</style>

<div class="custom-page-wrapper">
  <div class="section-label">— /// RETURNS & REFUNDS</div>
  <h1 class="custom-page-title">RETURNS</h1>
  <div class="custom-page-content">
    {% if page.content != blank %}
      {{ page.content }}
    {% else %}
      <h3 style="color:var(--accent); margin-bottom: 1.5rem; font-family:'Barlow Condensed', sans-serif; font-size: 2rem; text-transform: uppercase; font-weight: 800;">30-DAY RETURN POLICY</h3>
      <p>We accept returns on all unused objects in their original packaging within 30 days of delivery. If you are not entirely satisfied with your purchase, simply return the item in its original, unused condition with tags attached.</p>
      <p>To initiate a return, please contact our concierge team with your order number. Once your return is received and inspected, we will send you an email to notify you that we have received your returned item and process your refund.</p>
    {% endif %}
  </div>
</div>
